# Copy to .env and override for anything beyond local review.
# docker-compose.yml falls back to the insecure dev defaults shown here if unset.

# HMAC secret for signing access-token JWTs. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-change-me

# Shared secret gating account creation (sent as X-Signup-Secret). Whoever holds
# it can register accounts on the server — treat it like a password.
SIGNUP_SECRET=letmein

# CORS origins allowed to call the server (the WEB APP's origin, not the server's).
ALLOWED_ORIGINS=http://localhost:5173

# Enforce auth on /sync and /databases. Sync requires a logged-in user either way,
# so leave this true.
AUTH_REQUIRED=true

# Backend URL the web app talks to (baked into the browser client at dev-server
# start). Change only if you move the server off localhost:9000.
VITE_SYNC_URL=http://localhost:9000
